# Optional. Without a key the app runs in clearly labelled Demonstration Mode.
# Keep keys secret: never share them or commit .env.local.

# --- FREE option: Google Gemini ---
# 1. Go to https://aistudio.google.com/apikey and sign in with a Google account (no card needed)
# 2. Press "Create API key" and paste it below
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-latest, Google's newest Flash model)
GEMINI_MODEL=

# --- Claude (https://console.anthropic.com/) ---
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=

# If more than one key is set, the order is Claude, then Gemini, then OpenAI.
# To choose one yourself, set: anthropic, gemini or openai
AI_PROVIDER=
